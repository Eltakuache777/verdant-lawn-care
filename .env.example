# Copy this file to .env.local and fill in real values.
# See SETUP.md for exactly where to get each one.

# --- Database (Neon or Supabase Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Stripe (payments) ---
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- Google Maps (address autocomplete + lawn size estimate) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="AIza..."

# --- Anthropic (AI booking assistant) ---
ANTHROPIC_API_KEY="sk-ant-..."

# --- App URL (used for Stripe redirect links) ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Admin page password (protects /admin and price editing) ---
ADMIN_PASSWORD="pick-a-real-password"

# --- SendGrid (booking confirmation emails) ---
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="you@yourdomain.com"
