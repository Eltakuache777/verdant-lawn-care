// Real database schema for Greenline.
// Run `npm run db:push` after setting DATABASE_URL to create these tables for real.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Owner-editable "starting at" prices, shown on the Book page and used by the estimators.
model Service {
  id        String   @id @default(cuid())
  name      String   @unique // "Mowing", "Tree Trimming", "Landscaping Project", "Fence Building", "Pressure Washing"
  basePrice Float
  updatedAt DateTime @updatedAt
}

// Photos/videos of completed jobs, shown on the public "Our Work" page so
// customers can browse examples before booking. Staff upload these; anyone
// can view them, optionally filtered by service.
model PortfolioItem {
  id               String   @id @default(cuid())
  service          String // one of the Service names, or "General" for anything not tied to a specific service
  mediaUrl         String
  caption          String?
  uploadedByEmail  String?
  createdAt        DateTime @default(now())
}

// Owner-maintained material prices (sod, trees, rocks, bricks, etc.) — no public
// API exists for real Lowe's/Home Depot pricing, so these are entered by hand.
model Material {
  id        String   @id @default(cuid())
  name      String   @unique
  unit      String // "sq ft", "each", "ton", "cu yd", etc.
  price     Float
  updatedAt DateTime @updatedAt
}

model Customer {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  address       String? // saved from their most recent booking so it's prefilled next time
  passwordHash  String? // optional — set after signup so they don't need a new email code every time
  createdAt     DateTime  @default(now())
  bookings      Booking[]
  quotes        QuoteRequest[]
  recurringPlan RecurringPlan?
  // Standing cadence preference for these two services — set from the
  // account page, prefilled into future bookings. weekly | biweekly | monthly | bimonthly
  mowingFrequency      String?
  binCleaningFrequency String?
  blocked       Boolean   @default(false) // admin can block a customer from logging in, booking, or messaging
  reviews       Review[]
}

// A public star rating + comment from a customer, shown on the /reviews
// page and folded into AggregateRating structured data for SEO (Google can
// show star ratings right in search results once there's real review
// history). Must be logged in as a customer to leave one, but every review
// goes live immediately — admin can delete anything inappropriate after the
// fact, same moderation pattern as portfolio items and chat messages.
model Review {
  id           String   @id @default(cuid())
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   String
  customerName String
  rating       Int // 1-5
  comment      String
  service      String? // optional: which service this review is about
  createdAt    DateTime @default(now())
}

// An ongoing lawn-care arrangement the owner sets up for a specific customer —
// a custom per-visit price (their lawn's actual size/condition, not a generic
// rate) plus how often they're serviced. The recurring-booking engine
// (lib/recurringPlans.ts) automatically creates the next Booking when one
// comes due and emails the customer, so nobody has to manually re-book.
model RecurringPlan {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    String   @unique
  services      String[] @default([])
  address       String
  frequency     String // weekly | biweekly | every_3_weeks | monthly
  pricePerVisit Float
  active        Boolean  @default(true)
  nextDate      DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Booking {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    String
  services      String[] @default([]) // service names at time of booking (customers can pick more than one)
  planFrequency String? // customer's requested cadence: weekly | biweekly | monthly | one_time (informational — no recurring billing yet)
  address       String
  scheduledFor  DateTime
  isEmergency   Boolean  @default(false)
  emergencyFee  Float    @default(0)
  basePrice     Float
  totalPrice    Float
  status        String   @default("pending") // pending | confirmed | completed | cancelled
  paymentMethod String? // "cash" | "zelle" | "venmo" — how the customer said they'll pay, chosen at booking time
  amountPaid    Float? // actual amount collected — entered by the owner once the job's done
  completedAt   DateTime?
  assignedWorkerEmail String? // which staff member (admin or worker) is attending this job
  assignedWorkerName  String?
  mowingFrequency      String? // customer's chosen cadence for Mowing on this booking, if selected
  binCleaningFrequency String? // customer's chosen cadence for Bin Cleaning on this booking, if selected
  reminderSentAt DateTime? // set once the 24-hours-before reminder email has gone out, so the background job never sends it twice
  createdAt     DateTime @default(now())
}

// A payout the owner made to an employee — a simple running log, not tied to
// specific jobs (workers aren't assigned to individual bookings in this app).
model WorkerPayment {
  id             String   @id @default(cuid())
  workerEmail    String
  workerName     String
  amount         Float
  note           String?
  paidAt         DateTime @default(now())
}

// Staff — the owner and employees, who all get full access. isAdmin is purely
// a label (they have identical permissions) except it's who "Manage workers"
// treats as an owner. Login is by email + one-time code, with an optional
// password afterward so it's not required every time.
model Worker {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  isAdmin      Boolean  @default(false)
  addedAt      DateTime @default(now())
}

// A one-time login code emailed to someone (customer, worker, or the owner)
// so they can sign in without a password. Expires 10 minutes after creation.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, code])
}

// A customer's request for an AI design concept package (the $50/$70/$120 tiers).
model QuoteRequest {
  id            String   @id @default(cuid())
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    String
  tier          String   // "standard" | "better" | "highest"
  amountPaid    Float
  conceptCount  Int
  photoUrls     String[] @default([]) // reference photos/videos of the project idea
  description   String?
  conceptUrls   String[] @default([]) // AI-generated design concept image URLs
  conceptVideoUrls String[] @default([]) // AI-generated video clips (Veo) for the first few concepts
  conceptMaterials String[] @default([]) // materials/plants list per concept, same index as conceptUrls (empty string if that one failed)
  chosenConcept String?
  status        String   @default("awaiting_payment") // awaiting_payment | paid | generating | generated | quoted | closed
  stripeSessionId String?
  createdByStaffEmail String? // set when generated via the free admin/worker tool — whoever was logged in and submitted it
  createdAt     DateTime @default(now())
}

// A single photo or video someone chose to keep from an AI Design batch,
// rather than the whole 5/15/50-concept dump — shown as "Saved Designs" on
// the customer account page and in each staff member's own Design tab.
// ownerEmail works for either a customer or a staff member (same session
// concept, just a different role) since it's just whoever is logged in.
model SavedDesignItem {
  id             String   @id @default(cuid())
  ownerEmail     String
  quoteRequestId String
  mediaUrl       String
  createdAt      DateTime @default(now())

  @@unique([ownerEmail, mediaUrl])
}

// Free-text "what would make this better" submissions from the feedback button —
// separate from the support chat, which is for specific issues needing a reply.
model Feedback {
  id        String   @id @default(cuid())
  message   String
  email     String?
  page      String?
  createdAt DateTime @default(now())
}

// A single private message in a customer <-> admin conversation, grouped by customerEmail.
model ChatMessage {
  id              String   @id @default(cuid())
  customerEmail   String
  customerName    String
  sender          String   // "customer" | "admin"
  body            String
  attachmentUrls  String[] @default([]) // photos/videos of a project idea attached to a quote request
  createdAt       DateTime @default(now())
}

// Internal staff messaging — separate from the customer support chat above.
// A thread is either a 1:1 (isGroup false, exactly 2 members) or a named
// group chat among any number of staff.
model StaffThread {
  id        String              @id @default(cuid())
  name      String? // set for group chats; 1:1 threads are labeled by the other member's name in the UI
  isGroup   Boolean             @default(false)
  createdAt DateTime            @default(now())
  members   StaffThreadMember[]
  messages  StaffMessage[]
}

model StaffThreadMember {
  id          String      @id @default(cuid())
  thread      StaffThread @relation(fields: [threadId], references: [id])
  threadId    String
  workerEmail String
  workerName  String?
  joinedAt    DateTime    @default(now())

  @@unique([threadId, workerEmail])
}

model StaffMessage {
  id             String      @id @default(cuid())
  thread         StaffThread @relation(fields: [threadId], references: [id])
  threadId       String
  senderEmail    String
  senderName     String?
  body           String
  attachmentUrls String[]    @default([])
  createdAt      DateTime    @default(now())
}

// A browser's push subscription for a given person (customer, worker, or
// admin), keyed by email. One person can have several — one per device/
// browser they enabled notifications on.
model PushSubscription {
  id        String   @id @default(cuid())
  email     String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([email])
}
